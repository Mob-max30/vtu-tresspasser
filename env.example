# LLM provider — kept abstract per README section 10. Only needed for the
# natural-language intent layer (e.g. "what's my Physics cycle CGPA?"),
# NOT for classification, SGPA/CGPA math, or validation (those are
# deterministic per README rule 9 — no LLM calls in that code path).
LLM_PROVIDER=anthropic          # anthropic | openai | gemini
LLM_API_KEY=

# Webcmd daemon (defaults shown; only override if yours differs)
WEBCMD_DAEMON_PORT=9777

# Backend
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
